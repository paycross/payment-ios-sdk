/* Separator between the Apple Pay button and the card fields */
"paycross_or_pay_with_card" = "Or pay with card";

/* Label above the cardholder name field */
"paycross_cardholder_name" = "Cardholder Name";

/* Placeholder inside the cardholder name field */
"paycross_name_on_card" = "NAME ON CARD";

/* Label above the card number field */
"paycross_card_number" = "Card Number";

/* Label above the expiry field, showing the expected shape.
   The field itself still takes MM/YY digits in every language. */
"paycross_expiry_label" = "MM/YY";

/* Label above the card security code field */
"paycross_cvv" = "CVV";

/* Toggle offering to store the card for a later payment */
"paycross_save_this_card" = "Save card for future use";

/* Row that switches from a stored card back to card entry */
"paycross_use_a_new_card" = "Use a new card";

/* Caption above the amount being paid */
"paycross_total" = "Total";

/* Pay button. %@ is the formatted amount, e.g. "Pay €12.00" */
"paycross_pay_amount" = "Pay %@";

/* Title of the payment sheet, and of the 3-D Secure challenge over it */
"paycross_payment" = "Payment";

/* Button that starts the cancel confirmation, and the one on the challenge */
"paycross_cancel" = "Cancel";

/* Title of the cancel confirmation */
"paycross_cancel_payment_title" = "Cancel Payment?";

/* Confirms the cancellation */
"paycross_cancel_payment_yes" = "Yes, Cancel";

/* Dismisses the cancel confirmation and keeps paying */
"paycross_cancel_payment_continue" = "Continue Payment";

/* Body of the cancel confirmation */
"paycross_cancel_payment_message" = "Are you sure you want to cancel this payment?";

/* Shown when the merchant has no Apple Pay merchant identifier configured */
"paycross_apple_pay_not_configured" = "Apple Pay is not configured for this merchant.";

/* Button above the numeric keypad that puts it away */
"paycross_keyboard_done" = "Done";

/* VoiceOver label on the button that deletes a stored card. %@ is the row it
   belongs to, e.g. "Visa •••• 1111", so the cards can be told apart */
"paycross_remove_card" = "Remove card, %@";

/* Title of the confirmation raised before a stored card is deleted */
"paycross_remove_card_title" = "Remove this card?";

/* Body of the delete confirmation. %@ is the row being deleted */
"paycross_remove_card_message" = "%@ will no longer be offered for future payments.";

/* Confirms the deletion */
"paycross_remove_card_confirm" = "Remove";

/* Shown when the card could not be deleted */
"paycross_remove_card_failed" = "Could not remove the card. Try again.";

/* Shown when the session token is rejected and nothing more can be done with it */
"paycross_session_expired" = "This payment session has expired. Start again.";

/* Banner on the re-armed form after a decline the shopper may retry */
"paycross_error_payment_failed" = "Payment failed. Please try again.";

/* Banner when the submission never reached the server */
"paycross_error_network" = "Network error. Please try again.";

/* Banner when the server refused the submission and sent no sentence of its own */
"paycross_error_submission_failed" = "Payment submission failed";

/* Shown when a second Apple Pay sheet is asked for while one is open */
"paycross_error_apple_pay_busy" = "An Apple Pay sheet is already open.";

/* Integrator-facing. Apple's sheet refused to present. %@ is the merchant
   identifier the SDK asked with */
"paycross_error_apple_pay_presentation" = "Apple Pay could not be presented for %@. Check the app's Apple Pay entitlement and the merchant identifier.";

/* Shown when Apple Pay hands back a payment token the SDK cannot parse */
"paycross_error_apple_pay_token" = "Apple Pay returned a token this SDK could not read.";

/* Client-side validation of a server-driven field. %@ is the field's label,
   or its name when the server sent none. A message the server sent with the
   field wins over this one */
"paycross_field_required" = "%@ is required";

/* The same field failed the server's pattern. %@ is the same label */
"paycross_field_invalid" = "%@ is invalid";

/* VoiceOver name for a required server-driven field. %@ is the field's own
   label, e.g. "Address line 1". The sheet draws a "*" beside that label, which
   an assistive technology either skips or spells out */
"paycross_field_required_accessibility" = "%@, required";

/* The same field is longer than the server's max_length. The first %@ is the
   field's label, the second the limit in characters. A message the server sent
   with the field wins over this one */
"paycross_field_max_length" = "%@ must be %@ characters or fewer";
